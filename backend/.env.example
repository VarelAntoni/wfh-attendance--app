# Database configuration
# Set DB_TYPE=mysql to connect to MySQL database
# Supported DB_TYPE: 'mysql' | 'postgres' | 'sqlite'
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=wfh_user
DB_PASSWORD=wfh_password
DB_DATABASE=wfh_attendance

# JWT Secret
JWT_SECRET=super_secret_jwt_key_wfh_attendance_2026

# Microservice Ports (TCP)
EMPLOYEE_SERVICE_HOST=127.0.0.1
EMPLOYEE_SERVICE_PORT=3001
ATTENDANCE_SERVICE_HOST=127.0.0.1
ATTENDANCE_SERVICE_PORT=3002

# Gateway HTTP Port
PORT=3000
