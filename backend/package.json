{
  "name": "wfh-attendance-backend",
  "version": "1.0.0",
  "description": "Backend Microservices for WFH Attendance & Monitoring System",
  "scripts": {
    "build": "tsc",
    "start:gateway": "ts-node src/api-gateway/main.ts",
    "start:employee": "ts-node src/employee-service/main.ts",
    "start:attendance": "ts-node src/attendance-service/main.ts",
    "start:all": "concurrently -n \"GATEWAY,EMPLOYEE_MS,ATTENDANCE_MS\" -c \"blue,green,magenta\" \"npm run start:gateway\" \"npm run start:employee\" \"npm run start:attendance\"",
    "start:dev": "npm run start:all"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
